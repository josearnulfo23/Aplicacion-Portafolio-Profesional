{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExperienciasLaborales",
  "description": "Lista de experiencias laborales para el timeline visual (HU-002, RF-003)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "cargo",
      "empresa",
      "periodoInicio",
      "periodoFin",
      "responsabilidades",
      "logrosCuantificables"
    ],
    "properties": {
      "id": { "type": "string" },
      "cargo": { "type": "string" },
      "empresa": { "type": "string" },
      "ubicacion": { "type": "string" },
      "modalidad": { "type": "string" },
      "periodoInicio": { "type": "string" },
      "periodoFin": { "type": "string" },
      "estaVigente": { "type": "boolean" },
      "descripcion": { "type": "string" },
      "responsabilidades": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "logrosCuantificables": {
        "type": "array",
        "minItems": 2,
        "items": { "type": "string" }
      },
      "tecnologias": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
