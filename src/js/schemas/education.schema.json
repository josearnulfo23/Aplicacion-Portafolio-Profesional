{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EducacionYCertificaciones",
  "description": "Formación académica y certificaciones profesionales (RF-008)",
  "type": "object",
  "required": ["titulosAcademicos", "certificaciones"],
  "properties": {
    "titulosAcademicos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tituloAcademico", "institucion", "anio"],
        "properties": {
          "tituloAcademico": { "type": "string" },
          "institucion": { "type": "string" },
          "anio": { "type": "string" },
          "estado": { "type": "string" },
          "descripcion": { "type": "string" }
        }
      }
    },
    "certificaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nombre", "entidadCertificadora", "anio"],
        "properties": {
          "nombre": { "type": "string" },
          "entidadCertificadora": { "type": "string" },
          "anio": { "type": "string" },
          "credencialUrl": { "type": "string" },
          "badgeDigital": { "type": "string" }
        }
      }
    }
  }
}
