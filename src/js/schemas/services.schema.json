{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Servicios",
  "description": "Listado de servicios profesionales de consultoría (HU-010, RF-006)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nombreServicio",
      "descripcion",
      "icono",
      "entregables",
      "ctaTexto"
    ],
    "properties": {
      "id": { "type": "string" },
      "nombreServicio": { "type": "string" },
      "categoria": { "type": "string" },
      "descripcion": { "type": "string" },
      "icono": { "type": "string" },
      "entregables": {
        "type": "array",
        "minItems": 2,
        "items": { "type": "string" }
      },
      "ctaTexto": { "type": "string" },
      "ctaDestino": { "type": "string" }
    }
  }
}
