{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proyectos",
  "description": "Portafolio de proyectos realizados y casos de estudio (HU-004, RF-005)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "idProyecto",
      "titulo",
      "descripcionBreve",
      "descripcionDetallada",
      "categoria",
      "tecnologiasUtilizadas",
      "imagenRepresentativa",
      "resultadosObtenidos"
    ],
    "properties": {
      "idProyecto": { "type": "string" },
      "titulo": { "type": "string" },
      "subtitulo": { "type": "string" },
      "categoria": {
        "type": "string",
        "enum": ["Desarrollo TI", "Análisis de Datos", "Seguridad y Control", "Consultoría"]
      },
      "descripcionBreve": { "type": "string" },
      "descripcionDetallada": { "type": "string" },
      "tecnologiasUtilizadas": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "imagenRepresentativa": { "type": "string" },
      "resultadosObtenidos": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "enlaceDemo": { "type": "string" },
      "enlaceGitHub": { "type": "string" },
      "destacado": { "type": "boolean" },
      "metricasImpacto": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["indicador", "valor"],
          "properties": {
            "indicador": { "type": "string" },
            "valor": { "type": "string" }
          }
        }
      }
    }
  }
}
